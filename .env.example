# TradeEvidence environment variables (Epic E1, AC-07).
#
# This file names every variable the application reads. It carries no
# values or credentials — copy it to `.env.local` (already gitignored)
# and fill in values there. Every variable below is optional in the
# sense that the application starts and runs without it (falling back
# to a bundled illustrative fixture or an experimental feature staying
# off); each is validated when set, so a malformed value fails fast at
# startup/readiness rather than surfacing as a confusing downstream
# error. See `src/infrastructure/config/env.ts` and `flags.ts`.

# --- Analytics publication (file-backed, see file-candidate-publication.ts) ---

# Path (relative to the repo root) to a versioned Evidence Engine v2
# candidate artifact (JSON). Unset -> illustrative demo fallback.
TRADEEVIDENCE_ANALYTICS_ARTIFACT=

# Path to a symbol-evidence CSV export used to enrich the loaded
# candidate artifact with live price/EMA/SMA fields. Unset -> enrichment
# is skipped.
TRADEEVIDENCE_SYMBOL_EVIDENCE_FILE=

# Path to an instrument-reference CSV export (company name, exchange,
# currency). Unset -> enrichment is skipped.
TRADEEVIDENCE_INSTRUMENT_REFERENCE_FILE=

# Path to the broad-market/sector context candidate artifact (same
# engine, run against the 14-symbol context export). Unset -> the
# Market & Sector Snapshot has nothing to show even when its flag
# below is enabled.
TRADEEVIDENCE_CONTEXT_ARTIFACT=

# --- Feature flags / kill switches (server-owned, see flags.ts) ---
# Every flag is "true" or "false". Unset means the documented default
# below. None of these can be changed from the browser.

# Homepage Market & Sector Snapshot. Experimental, not part of the
# published analytics contract (AC-09). Default: false (off).
TRADEEVIDENCE_FLAG_MARKET_CONTEXT_ENABLED=

# "Ask TradeEvidence" (Epic E9, not built yet). Default: false (off).
TRADEEVIDENCE_FLAG_AI_ENABLED=

# Any user-facing data export (Epic E7+, not built yet). Default: false (off).
TRADEEVIDENCE_FLAG_EXPORTS_ENABLED=

# --- Database (Epic E2) ---

# Postgres connection string (pooled connection string from your Supabase
# project's Settings > Database page). Unused by anything wired into the
# app yet — only src/infrastructure/db, applied via `npm run db:migrate`.
DATABASE_URL=
