{
  "name": "tradeevidence-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \".github/**/*.{yml,yaml,md}\" \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"test/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml,md}\" \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"test/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:web",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:analytics": "python -m unittest discover -s analytics-engine/tests -v",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "secrets:check": "node scripts/check-tracked-secrets.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:web && npm run test:analytics && npm run docs:check && npm run secrets:check && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
